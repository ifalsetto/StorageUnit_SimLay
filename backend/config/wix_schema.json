      "required": true
    },
    "Name": {
      "source": "final_name",
      "required": true
    },
    "Visible": {
      "source": "constant",
      "value": "TRUE",
      "required": true
    },
    "plainDescription": {
      "source": "template",
      "template": "Pre-owned {visible_condition}. {notes}",
      "fallback": "Pre-owned item. Honest condition. See photos for details.",
      "required": true
    },
    "media": {
      "source": "public_media_url",
      "required": false
    },
    "mediaAltText": {
      "source": "final_name",
      "required": false
    },
    "Brand": {
      "source": "brand",
      "required": false,
      "condition": "confidence == 'Verified'"
    },
    "Price": {
      "source": "value_export",
      "required": false,
      "format": "{:.0f}"
    },
    "inventory": {
      "source": "quantity",
      "required": false
    },
    "SKU (auto)": {
      "source": "wix_sku",
      "required": true
