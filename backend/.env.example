# StorageUnit SimLay Environment
# Copy this file to .env or set variables in PowerShell.

# Required only for real OpenAI Vision calls.
OPENAI_API_KEY=

# Optional future eBay official API connector.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Optional runtime overrides.
SIMLAY_ENV=development

# Production CORS origins, comma-separated. Include your hosted frontend URL and optional Android WebView URL.
SIMLAY_CORS_ORIGINS=https://your-frontend-domain.com
